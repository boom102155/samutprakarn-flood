NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Protects GET /api/cron/weather-alerts from public calls.
CRON_SECRET=

# TMD WeatherWarningNews public-example credentials; register production credentials at data.tmd.go.th.
TMD_API_UID=demo
TMD_API_KEY=demokey

# OAuth Access Token from https://data.tmd.go.th/nwpapi/login (server-side only).
TMD_NWP_ACCESS_TOKEN=
